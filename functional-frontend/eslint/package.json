{
  "name": "eslint-config-functional-frontend",
  "version": "0.1.0",
  "description": "\"쏙쏙 들어오는 함수형 코딩\" 원칙을 React + TypeScript 프론트엔드에 강제하는 ESLint 프리셋",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./plugin": "./plugin.js"
  },
  "files": ["index.js", "plugin.js", "rules", "presets"],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:fixtures": "node tests/run-fixtures.js"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-functional": { "optional": true },
    "eslint-plugin-import-x": { "optional": true },
    "typescript-eslint": { "optional": true }
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "eslint-plugin-functional": "^7.0.0",
    "eslint-plugin-import-x": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "keywords": ["eslint", "functional", "grokking-simplicity", "react", "architecture"],
  "license": "MIT"
}
